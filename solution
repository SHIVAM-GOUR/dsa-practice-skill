class solution {
    public int solution(int[] nums) {
        int count = 0;
        for(int i=0; i<nums.length; i ++) {
            int digits = 0;
            int n = nums[i];

            while( n > 0) {
                n /= 10;
                digits++;
            }
            // if (String.valueOf(nums[i]).length() % 2 == 0) {
            if (digits % 2 == 0) {
                count++;
            }
        }

        return count;

    }
}

