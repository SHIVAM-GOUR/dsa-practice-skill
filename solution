
class solution {
    public int solution(int[] nums) {
        int output = 0;
        int x = 0;
        int y = 0;
        for (int i = 0; i < nums.length; i++) {
            int n = nums[i];
            if (n >= x) {
                y = x;
                x = n;
            } else if (n >= y && n <= x) {
                y = n;
            }
        }
        output = (x - 1) * (y - 1);
        return output;
    }
}
