class solution {
    public int solution(int[] nums) {
        int output = 0;
        int x = 0;
        int y = 0;
        for(int i = 0; i < nums.length; i++) {
            if (nums[i] >= nums[x]) {
                y = x;
                x = i;
            }
        }
        output = (nums[x]-1)*(nums[y]-1); 
        return output;

    }
}

