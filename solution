class solution {
    public int[] solution(int[] nums, int n) {
        int[] output = new int[nums.length];

        int i = 0;
        int p = 0;

        while(i < nums.length) {
            output[i] = nums[p];
            output[i+1] = nums[p+n];
            i += 2;
            p++;
        }

        return output;

    }
}
